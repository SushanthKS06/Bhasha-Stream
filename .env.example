# ============================================================
# Bhasha-Stream — Environment Configuration Template
# Copy to .env and fill in real values before running.
# DO NOT commit .env to version control.
# ============================================================

# ----- vLLM / LLM Configuration -----
# URL of the running vLLM OpenAI-compatible endpoint
VLLM_ENDPOINT=http://vllm:8001/v1

# HuggingFace model ID to serve (must match Dockerfile.vllm CMD)
LLM_MODEL=sarvamai/sarvam-m

# API key for vLLM (set to any string for local deployments)
LLM_API_KEY=bhasha-local-key

# ----- STT Configuration -----
# Whisper model size: tiny | base | small | medium | large-v3
STT_MODEL_SIZE=tiny

# Compute device: cuda | cpu
STT_DEVICE=cuda

# Compute type: float16 | int8 | float32
STT_COMPUTE_TYPE=float16

# ----- TTS Configuration -----
# TTS engine: melotts | vits
TTS_ENGINE=melotts

# Language code for synthesis
TTS_LANGUAGE=EN

# Numeric speaker ID (MeloTTS EN speaker 0 = default EN voice)
TTS_SPEAKER_ID=0

# ----- VAD Configuration -----
# Path to silero_vad.onnx model file inside the container
VAD_MODEL_PATH=/app/models/silero_vad.onnx

# ----- Network -----
# Comma-separated list of allowed CORS origins
# Use * for development; restrict in production
ALLOWED_ORIGINS=*

# ----- HuggingFace (for model downloads) -----
HF_TOKEN=
HF_HOME=/app/hf_cache
