# docker/Dockerfile.vllm
# ============================================================
# vLLM OpenAI-compatible inference server
# Serves Sarvam-M (or any HF model) on port 8001
# to avoid collision with the FastAPI backend on port 8000
# ============================================================
FROM vllm/vllm-openai:latest

# Environment variables for HuggingFace model caching
ENV HF_HOME=/app/hf_cache \
    TRANSFORMERS_CACHE=/app/hf_cache \
    # Disable P2P NVLink for single-GPU setups (safe to enable on multi-GPU with NVLink)
    NCCL_P2P_DISABLE=1

# Create cache directory with open permissions (vllm image runs as root by default)
RUN mkdir -p /app/hf_cache && chmod 777 /app/hf_cache

# Expose vLLM on port 8001 (backend port 8000 is separate — BUG-23 fix)
EXPOSE 8001

# Use the official vLLM entrypoint — model/args passed via docker-compose CMD override
ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]

CMD [ \
    "--host", "0.0.0.0", \
    "--port", "8001", \
    "--model", "sarvamai/sarvam-m", \
    "--dtype", "float16", \
    "--max-model-len", "2048", \
    "--gpu-memory-utilization", "0.90", \
    "--enforce-eager" \
]