# docker/Dockerfile.vllm
# Based on official vLLM OpenAI-compatible image
FROM vllm/vllm-openai:latest

# Environment variables for Hugging Face and Model Cache optimization
ENV HF_HOME=/tmp/hf_cache \
    VLLM_NCCL_SO_PATH=/usr/local/lib/python3.10/dist-packages/vllm/nccl/cuda_compat/libnccl.so.2 \
    NCCL_P2P_DISABLE=1 \
    TRANSFORMERS_CACHE=/tmp/hf_cache

# Create cache directory
RUN mkdir -p /tmp/hf_cache && chmod 777 /tmp/hf_cache

# Expose vLLM default port
EXPOSE 8000

# Default command to run the server
# Note: Model name and quantization should be passed via docker-compose or k8s args
ENTRYPOINT ["python3", "-m", "vllm.entrypoints.openai.api_server"]

CMD [
    "--host", "0.0.0.0",
    "--port", "8000",
    "--model", "sarvamai/sarvam-m",
    "--dtype", "float16",
    "--max-model-len", "2048",
    "--gpu-memory-utilization", "0.90",
    "--enforce-eager"
]